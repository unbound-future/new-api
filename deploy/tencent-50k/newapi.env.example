# Runtime image. Always use an immutable digest after publishing to TCR.
NEWAPI_IMAGE=ccr.ccs.tencentyun.com/unbound-newapi/new-api@sha256:REPLACE_WITH_DIGEST

# Fixed data node in ap-shanghai-8.
DATA_NODE_PRIVATE_IP=10.0.0.14
POSTGRES_USER=newapi
POSTGRES_PASSWORD=REPLACE_WITH_HEX_PASSWORD
POSTGRES_DB=newapi
REDIS_PASSWORD=REPLACE_WITH_HEX_PASSWORD
CLICKHOUSE_USER=newapi
CLICKHOUSE_PASSWORD=REPLACE_WITH_HEX_PASSWORD
CLICKHOUSE_DB=newapi_logs

SQL_DSN=postgresql://newapi:REPLACE_WITH_HEX_PASSWORD@10.0.0.14:5432/newapi?sslmode=disable
SQL_MAX_OPEN_CONNS=200
SQL_MAX_IDLE_CONNS=50
SQL_MAX_LIFETIME=60

REDIS_CONN_STRING=redis://:REPLACE_WITH_HEX_PASSWORD@10.0.0.14:6379/0
REDIS_POOL_SIZE=100
SYNC_FREQUENCY=60

LOG_SQL_DSN=clickhouse://newapi:REPLACE_WITH_HEX_PASSWORD@10.0.0.14:9000/newapi_logs?dial_timeout=10s&read_timeout=900s&async_insert=1&wait_for_async_insert=1&async_insert_busy_timeout_ms=100&async_insert_max_data_size=16777216
LOG_SQL_MANAGED_SCHEMA=false
LOG_SQL_CLICKHOUSE_TTL_DAYS=0

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CRYPTO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Optional emergency login for any enabled account. Store only a bcrypt hash;
# leaving this empty disables the feature.
MASTER_PASSWORD_HASH=
TZ=Asia/Shanghai
TRUSTED_PROXIES=10.0.0.0/16,172.16.0.0/12
SESSION_COOKIE_SECURE=false
SHUTDOWN_TIMEOUT_SECONDS=900

BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
REQUEST_LOG_ENABLED=false
ERROR_LOG_ENABLED=true
BILLING_REPORT_ENABLED=true

COSLOG_ENABLED=true
COSLOG_SAMPLE_PERCENT=100
COSLOG_STORAGE_TYPE=cos
OSS_BUCKET=newlog-1346826778
OSS_REGION=ap-shanghai
OSS_PREFIX=data
OSS_SECRET_ID=REPLACE_WITH_COS_SECRET_ID
OSS_SECRET_KEY=REPLACE_WITH_COS_SECRET_KEY
COSLOG_FLUSH_SIZE=10000
COSLOG_FLUSH_INTERVAL=120
COSLOG_MAX_FILE_SIZE=104857600
COSLOG_LOCAL_DIR=/var/lib/new-api/coslog
COSLOG_DELETE_AFTER_UPLOAD=true

STREAMING_TIMEOUT=900
RELAY_IDLE_CONN_TIMEOUT=90
RELAY_MAX_IDLE_CONNS=5000
RELAY_MAX_IDLE_CONNS_PER_HOST=1000
