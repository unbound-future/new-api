# This file is copied to /etc/newapi/newapi.env with mode 0600 on every app VM.
# URL-encode reserved characters in database, Redis, and ClickHouse passwords.

NEWAPI_IMAGE=useccr.ccs.tencentyun.com/newapi-prod/new-api@sha256:REPLACE_WITH_DIGEST

SQL_DSN=postgresql://newapi:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_POSTGRES_PRIVATE_HOST:5432/newapi?sslmode=disable
SQL_MAX_OPEN_CONNS=200
SQL_MAX_IDLE_CONNS=50
SQL_MAX_LIFETIME=60

REDIS_CONN_STRING=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_REDIS_PRIVATE_HOST:6379/0
REDIS_POOL_SIZE=100
SYNC_FREQUENCY=60

LOG_SQL_DSN=clickhouse://newapi:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_CLICKHOUSE_PRIVATE_HOST:9000/newapi_logs?dial_timeout=10s&read_timeout=900s&async_insert=1&wait_for_async_insert=1&async_insert_busy_timeout_ms=100&async_insert_max_data_size=16777216
LOG_SQL_MANAGED_SCHEMA=false
LOG_SQL_CLICKHOUSE_TTL_DAYS=0

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CRYPTO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TZ=Asia/Shanghai
TRUSTED_PROXIES=REPLACE_WITH_CLB_PRIVATE_CIDR
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://REPLACE_WITH_API_DOMAIN
SHUTDOWN_TIMEOUT_SECONDS=900

BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
REQUEST_LOG_ENABLED=false
ERROR_LOG_ENABLED=true
BILLING_REPORT_ENABLED=true

COSLOG_ENABLED=true
COSLOG_SAMPLE_PERCENT=10
COSLOG_STORAGE_TYPE=cos
OSS_BUCKET=newlog-data-1346826778
OSS_REGION=na-ashburn
OSS_PREFIX=us/tencent-prod
OSS_SECRET_ID=REPLACE_WITH_COS_SECRET_ID
OSS_SECRET_KEY=REPLACE_WITH_COS_SECRET_KEY
COSLOG_FLUSH_SIZE=10000
COSLOG_FLUSH_INTERVAL=120
COSLOG_MAX_FILE_SIZE=104857600
COSLOG_LOCAL_DIR=/var/lib/new-api/coslog
COSLOG_DELETE_AFTER_UPLOAD=true

STREAMING_TIMEOUT=900
RELAY_IDLE_CONN_TIMEOUT=90
RELAY_MAX_IDLE_CONNS=5000
RELAY_MAX_IDLE_CONNS_PER_HOST=1000
